RUN_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Generate with: openssl rand -hex 32
RUN_AUTH_SECRET=replace-with-a-long-random-secret

# Resend API key and a verified sender/domain
RUN_RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RUN_LOGIN_EMAIL_FROM="Keep <connexion@your-domain.example>"

# Public origin used for absolute links and email assets
RUN_PUBLIC_APP_URL=https://keep.example.com
RUN_PUBLIC_APP_NAME=Keep

# Login email template (server-only)
RUN_LOGIN_CODE_SUBJECT="Votre code de connexion Keep"
RUN_LOGIN_CODE_EXPIRES_MINUTES=10
RUN_LOGIN_CODE_TEMPLATE=./server/email-templates/login-code.template.html
